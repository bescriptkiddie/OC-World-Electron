OC_CHAT_PROVIDER=hermes
# Default renderer is demos/oc-invisible-growth-v1.html. Set to 1 to use the Vite React renderer.
OC_WORLD_USE_VITE_RENDERER=0
HERMES_AUTOSTART=1
HERMES_RUNTIME_INSTALL=1
HERMES_AGENT_REPO=https://github.com/NousResearch/hermes-agent.git
HERMES_AGENT_REF=main
HERMES_BUNDLED_SOURCE=
HERMES_HOME=
AGENT_BROWSER_HOME=
HERMES_EXECUTABLE_PATH=
HERMES_EXECUTABLE_ARGS_JSON=
HERMES_BASE_URL=http://127.0.0.1:8642
HERMES_HEALTH_PATH=/health
HERMES_HEALTH_INTERVAL_MS=5000
HERMES_HEALTH_FAILURE_THRESHOLD=3
HERMES_RESTART_BASE_DELAY_MS=1000
HERMES_RESTART_MAX_DELAY_MS=30000
HERMES_STOP_TIMEOUT_MS=5000
HERMES_MODEL=mimo-v2.5-pro
HERMES_API_MODE=anthropic_messages
HERMES_INFERENCE_PROVIDER=custom
# Local API-server key. Required for Hermes session continuity.
HERMES_API_KEY=oc-world-local-key
API_SERVER_KEY=oc-world-local-key

ANTHROPIC_AUTH_TOKEN=
# Xiaomi MiMo Anthropic-compatible endpoint, used when OC_CHAT_PROVIDER=legacy.
ANTHROPIC_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
ANTHROPIC_DEFAULT_HAIKU_MODEL=mimo-v2.5-pro
# Hermes custom provider can reuse the same Xiaomi MiMo-compatible endpoint.
OPENAI_API_KEY=
CUSTOM_BASE_URL=https://token-plan-cn.xiaomimimo.com/anthropic
OC_DEMO_FORCE_MOCK_LLM=0
# Set to 1 when AirJelly is unavailable. The app will use oc-data/mock/airjelly-context.json.
OC_DEMO_FORCE_MOCK_AIRJELLY=0

# Hermes agent tools. Configure at least one web backend for web_search/web_extract.
OC_HERMES_WEB_BACKEND=firecrawl
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=
TAVILY_API_KEY=
EXA_API_KEY=
PARALLEL_API_KEY=
BROWSER_USE_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# StepFun speech. Leave STEPFUN_API_KEY empty to fall back to browser speechSynthesis for TTS.
OC_TTS_PROVIDER=stepfun
STEPFUN_API_KEY=
STEPFUN_TTS_ENDPOINT=https://api.stepfun.com/v1/audio/speech
STEPFUN_TTS_MODEL=stepaudio-2.5-tts
STEPFUN_TTS_VOICE=cixingnansheng
STEPFUN_TTS_FORMAT=mp3
STEPFUN_TTS_SAMPLE_RATE=24000
STEPFUN_TTS_SPEED=1
STEPFUN_TTS_VOLUME=1
STEPFUN_TTS_INSTRUCTION=

# StepFun ASR SSE. Used for microphone voice input.
STEPFUN_ASR_ENDPOINT=https://api.stepfun.com/v1/audio/asr/sse
STEPFUN_ASR_MODEL=stepaudio-2.5-asr
STEPFUN_ASR_LANGUAGE=zh
STEPFUN_ASR_ENABLE_ITN=1
STEPFUN_ASR_HOTWORDS=
STEPFUN_ASR_PROMPT=
STEPFUN_ASR_TIMEOUT_MS=60000

# Image generation (Marswave)
MARSWAVE_API_KEY=
