{
  "buildCommand": "cd ocworld-web && npm run build",
  "outputDirectory": "ocworld-web/dist",
  "framework": "vite",
  "installCommand": "cd ocworld-web && npm ci",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
